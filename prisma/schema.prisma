generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id_usuario Int    @id @default(autoincrement())
  nombre     String
  correo     String @unique
  contrasena String @map("contraseña")
  rol        Int
  changelogs Changelog[]

  @@map("users")
}

model Server {
  id     Int    @id @default(autoincrement())
  nombre String
  ip     String
  estado String
  cpu    Float
  ram    Float
  disco  Float
  red    Float

  @@map("servers")
}

model Config {
  id                 Int   @id @default(1)
  cpuThreshold       Float
  ramThreshold       Float
  monitoringInterval Int

  @@map("config")
}

model Changelog {
  id          Int      @id @default(autoincrement())
  descripcion String
  tipo        Int
  old         Json?
  new         Json?
  fecha       DateTime @default(now())
  
  id_usuario  Int
  user        User     @relation(fields: [id_usuario], references: [id_usuario])

  @@map("changelogs")
}