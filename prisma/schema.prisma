generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id_usuario Int    @id @default(autoincrement())
  nombre     String
  correo     String @unique
  contrasena String @map("contraseña")
  rol        Int

  @@map("users")
}

model Server {
  id     Int    @id @default(autoincrement())
  nombre String
  ip     String
  estado String
  cpu    Float
  ram    Float
  disco  Float
  red    Float

  @@map("servers")
}